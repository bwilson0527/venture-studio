# Copy to .env.local for local development. Never commit real values.

# Supabase project URL, its publishable (anon) key and its secret (service
# role) key. All three are read on the server only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Taxpayer IDs are encrypted with it before storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes every stored taxpayer ID unreadable. Back it up.
TIN_ENCRYPTION_KEY=

# At least 32 characters. Every vendor's private link is derived from it,
# so changing it breaks every link already emailed.
PORTAL_TOKEN_SECRET=

# The public address of the app, used in email links. No trailing slash.
APP_URL=http://localhost:3000

# Resend, for W-9 requests and reminders. EMAIL_FROM must be on a domain
# verified in Resend, for example: FormStickler <requests@example.com>
RESEND_API_KEY=
EMAIL_FROM=

# The signing secret (whsec_...) of the webhook you add in Resend for
# <APP_URL>/api/resend/webhook, with the events email.bounced and
# email.complained. Without it, bounces are not recorded.
RESEND_WEBHOOK_SECRET=

# The scheduler sends this as a bearer token to /api/cron/* routes.
CRON_SECRET=

# Stripe, for the paid plans. Leave both empty to keep paid plans switched
# off. The webhook secret (whsec_...) comes from the endpoint you add in
# Stripe for <APP_URL>/api/stripe/webhook, listening for
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
